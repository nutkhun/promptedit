{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptEdit",
  "version": "0.1.0",
  "identifier": "app.promptedit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PromptEdit",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "category": "Video",
    "shortDescription": "Fast video editing for Mac and PC",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "promptedit",
          "editroom"
        ],
        "name": "PromptEdit Project",
        "role": "Editor",
        "mimeType": "application/x-promptedit"
      }
    ]
  }
}